# ─── OpenMeerkat API ────────────────────────────────────────────────────────────

# Workspace token — found in OpenMeerkat Settings → Developer → API Keys
# Used for stdio transport. For SSE, pass via ?workspace_token= query param instead.
OPENMEERKAT_API_KEY=

# API base URL of your OpenMeerkat instance (e.g. https://app.openmeerkat.com/api)
# The MCP server fetches the OpenAPI spec from {OPENMEERKAT_API_URL}/public-spec.json
OPENMEERKAT_API_URL=

# Set to "true" to disable TLS certificate verification.
# Only use in local development with self-signed certificates.
OPENMEERKAT_ALLOW_SELF_SIGNED_CERT=

# ─── MCP Server (SSE / HTTP transport only) ──────────────────────────────────

# Transport mode: "stdio" | "sse" | "both"
# - stdio: Claude spawns the process directly (recommended for local use)
# - sse:   Run as an HTTP server — clients connect via URL
# - both:  Run stdio and SSE simultaneously
OPENMEERKAT_MCP_TRANSPORT=sse

# Host the SSE server listens on (use 127.0.0.1 for local, 0.0.0.0 for public)
OPENMEERKAT_MCP_HOST=127.0.0.1

# Port the SSE server listens on
OPENMEERKAT_MCP_PORT=3333

# URL path for the SSE endpoint
OPENMEERKAT_MCP_SSE_PATH=/sse

# URL path for the JSON-RPC messages endpoint
OPENMEERKAT_MCP_MESSAGES_PATH=/messages

# ─── Server identity (sent to AI clients on connect) ─────────────────────────

# Display name shown to AI clients (e.g. Claude, ChatGPT).
# Defaults to the package name if not set.
OPENMEERKAT_MCP_SERVER_NAME=OpenMeerkat MCP Server

# Instructions the AI client reads on connect to understand what this server
# does and when to invoke its tools. Useful for clients like ChatGPT.com that
# require explicit guidance to activate tools.
OPENMEERKAT_MCP_SERVER_INSTRUCTIONS=This MCP server is connected to the user's live OpenMeerkat workspace. Whenever the user asks about anything related to their OpenMeerkat workspace — tags, contacts, conversations, broadcasts, flows, sequences, team members, inboxes, or any workspace data — you MUST use the available MCP tools to fetch real-time data. Do NOT answer from training knowledge or provide OpenMeerkat product documentation.
