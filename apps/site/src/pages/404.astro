---
const GITHUB = "https://github.com/Reality-Shifting-Tech/OpenMeerkat"
---

<Layout
  title="Page not found | OpenMeerkat"
  description="This page does not exist."
>
  <section class="notfound">
    <p class="code">404</p>
    <h1>This page wandered off.</h1>
    <p>
      Even a mob post misses a signal sometimes. The page you are looking for
      moved, was renamed, or never existed.
    </p>
    <div class="cta">
      <a class="btn primary" href="/">Back home</a>
      <a class="btn ghost" href={GITHUB}>View GitHub</a>
    </div>
  </section>
</Layout>
